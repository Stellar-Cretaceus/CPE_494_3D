  <library_effects>
    <effect id="Core_orb-effect">
      <profile_COMMON>
        <newparam sid="Core_orb_baseColor_png-surface">
          <surface type="2D">
            <init_from>Core_orb_baseColor_png</init_from>
          </surface>
        </newparam>
        <newparam sid="Core_orb_baseColor_png-sampler">
          <sampler2D>
            <source>Core_orb_baseColor_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">1 1 1 1</color>
            </emission>
            <diffuse>
              <texture texture="Core_orb_baseColor_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="Lightning-effect">
      <profile_COMMON>
        <newparam sid="Lightning_baseColor_png-surface">
          <surface type="2D">
            <init_from>Lightning_baseColor_png</init_from>
          </surface>
        </newparam>
        <newparam sid="Lightning_baseColor_png-sampler">
          <sampler2D>
            <source>Lightning_baseColor_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">1 1 1 1</color>
            </emission>
            <diffuse>
              <texture texture="Lightning_baseColor_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
    <image id="Core_orb_baseColor_png" name="Core_orb_baseColor_png">
      <init_from>Core_orb_baseColor.png</init_from>
    </image>
    <image id="Lightning_baseColor_png" name="Lightning_baseColor_png">
      <init_from>Lightning_baseColor.png</init_from>
    </image>
  </library_images>
  <library_materials>
